{
  "name": "@sikt/sd3-design-tokens",
  "version": "0.2.0",
  "license": "UNLICENSED",
  "description": "Design tokens, Sikt design system",
  "homepage": "https://designsystem.sikt.no/",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.sikt.no/designsystem/sds-komponentbibliotek.git",
    "directory": "packages/design-tokens"
  },
  "type": "commonjs",
  "main": "dist/js/index.js",
  "module": "dist/js/index.mjs",
  "exports": {
    ".": {
      "style": "./dist/css/index.css",
      "import": {
        "types": "./dist/js/index.d.ts",
        "default": "./dist/js/index.mjs"
      },
      "require": {
        "types": "./dist/js/index.d.ts",
        "default": "./dist/js/index.js"
      }
    },
    "./dist/*": "./dist/*"
  },
  "types": "dist/js/index.d.ts",
  "style": "dist/css/index.css",
  "files": [
    "CHANGELOG.md",
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "prebuild": "npm run clean && npm run build:tokens",
    "build": "",
    "build:tokens": "node bin/build.mjs",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "json-to-ts": "^2.1.0",
    "style-dictionary": "^5.6.0",
    "tinycolor2": "^1.6.0"
  }
}
