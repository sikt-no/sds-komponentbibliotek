---
import Layout from "../../layouts/PageLayout.astro";
import { Hero } from "../../components";
import Search from "astro-pagefind/components/Search.astro";

const pageTitle = "Søk";
---

<Layout title={pageTitle}>
  <Hero
    breadcrumbs={[{ title: "Designsystem", href: "/" }]}
    heading={pageTitle}
  />

  <Search className="sds-search" searchboxOptions={{ autofocus: true }} />
</Layout>

<style is:global>
  pagefind-searchbox.sds-search {
    --pf-text: var(--sds-color-text-primary);
    --pf-text-secondary: var(--sds-color-text-secondary);
    --pf-text-muted: var(--sds-color-text-secondary);
    --pf-background: var(--sds-color-layout-background-default);
    --pf-border: var(--sds-color-layout-divider-strong);
    --pf-border-focus: var(--sds-color-layout-divider-strong);
    --pf-hover: var(--sds-color-interaction-primary-subtle-default);
    --pf-mark: var(--sds-color-text-primary);
    --pf-border-radius: var(--sds-space-border-radius-medium);
    --pf-font: Haffer, Arial, sans-serif;
    --pf-searchbox-max-width: 100%;
    --pf-input-height: var(--sds-base-size-l);
    --pf-input-font-size: var(--sds-typography-body-default-fontsize);
  }

  pagefind-searchbox.sds-search .pf-searchbox-input-wrapper::before {
    width: var(--sds-typography-fontsize-500) !important;
    height: var(--sds-typography-fontsize-500) !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    inset-inline-start: var(--sds-space-padding-small) !important;
  }

  pagefind-searchbox.sds-search .pf-searchbox-input {
    border-width: var(--sds-space-border-weight-regular) !important;
    padding-inline-start: calc(
      var(--sds-space-padding-small) + var(--sds-typography-fontsize-500) +
        var(--sds-space-padding-tiny)
    ) !important;
  }

  pagefind-searchbox.sds-search .pf-searchbox-input:focus,
  pagefind-searchbox.sds-search .pf-searchbox-input:focus-visible {
    border-color: var(--sds-color-layout-divider-strong) !important;
    box-shadow: none !important;
    outline: var(--sds-focus-outline) !important;
    outline-offset: 2px !important;
  }

  pagefind-searchbox.sds-search .pf-searchbox.open .pf-searchbox-input {
    border-radius: var(--sds-space-border-radius-medium) !important;
    border-bottom-color: var(--sds-color-layout-divider-strong) !important;
  }

  pagefind-searchbox.sds-search .pf-searchbox-dropdown {
    border: 0 none !important;
    border-radius: var(--sds-space-border-radius-medium) !important;
    box-shadow: var(--sds-effect-shadow-elevated-default) !important;
    margin-top: var(--sds-space-gap-small) !important;
    padding: var(--sds-space-padding-tiny) !important;
  }

  pagefind-searchbox.sds-search .pf-searchbox-result-title {
    font-size: var(--sds-typography-body-default-fontsize) !important;
    font-weight: var(--sds-typography-body-default-fontweight) !important;
    line-height: var(--sds-typography-body-default-lineheight) !important;
  }

  pagefind-searchbox.sds-search .pf-searchbox-result-excerpt {
    font-size: var(--sds-typography-body-s-fontsize) !important;
    line-height: var(--sds-typography-body-s-lineheight) !important;
  }

  pagefind-searchbox.sds-search .pf-searchbox-result[data-pf-selected] {
    background: var(--sds-color-interaction-primary-subtle-pressed) !important;
    color: var(--sds-color-text-primary) !important;
    outline: none !important;
  }

  pagefind-searchbox.sds-search .pf-searchbox-footer {
    border-top-color: var(--sds-color-layout-divider-subtle) !important;
    color: var(--sds-color-text-secondary);
  }

  pagefind-searchbox.sds-search .pf-searchbox-footer-key,
  pagefind-searchbox.sds-search .pf-keyboard-key {
    background: var(--sds-color-brand-primary-subtle) !important;
    border: 0 none !important;
    border-radius: var(--sds-space-border-radius-minimal) !important;
    color: var(--sds-color-text-primary) !important;
    font-family: var(--pf-font) !important;
    font-size: var(--sds-typography-body-s-fontsize) !important;
    font-weight: var(--sds-typography-body-s-fontweight) !important;
    line-height: var(--sds-typography-body-s-lineheight) !important;
    padding: 1px var(--sds-space-padding-minimal) !important;
    min-width: auto !important;
    height: auto !important;
  }
</style>
