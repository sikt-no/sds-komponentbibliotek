{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "description": "Sikt designsystem Claude marketplace",
  "name": "sikt-sds",
  "owner": {
    "name": "Sikt designsystem",
    "url": "https://designsystem.sikt.no/"
  },
  "plugins": [
    {
      "name": "sikt-sds",
      "description": "Sikt designsystem Claude plugins",
      "relevance": {
        "topic": "Sikt designsystem",
        "signals": {
          "manifestDeps": [
            {
              "file": "[/\\\\]package\\.json$",
              "pattern": "@sikt/sds-"
            },
            {
              "file": "[/\\\\]package\\.json$",
              "pattern": "\"react\":"
            }
          ],
          "filesRead": [
            "**/*.tsx"
          ]
        }
      },
      "source": "./.claude/plugins"
    }
  ],
  "version": "0.2.0"
}
